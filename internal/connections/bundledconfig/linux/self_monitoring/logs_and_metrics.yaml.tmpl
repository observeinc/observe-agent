{{- /* Forked from the default due to journald receiver */ -}}
receivers:
  # TODO: Add observe-agent.yaml once we can obfuscate sensitive config fields

  prometheus/agent:
    config:
      scrape_configs:
        - job_name: 'otelcol'
          scrape_interval: 10s
          static_configs:
            - targets: ['{{ .InternalTelemetry.Metrics.Host }}:{{ .InternalTelemetry.Metrics.Port }}']
          metric_relabel_configs:
            - source_labels: [__name__]
              regex: '.*grpc_io.*'
              action: drop

  journald/agent:
    units:
      - observe-agent
    priority: info

processors:
  # Collector v0.155.0 renamed the memory_limiter metrics from otelcol_processor_* to
  # otelcol_processor_memory_limiter_*. Emit both names until content moves to the new ones.
  transform/memory_limiter_legacy_names:
    error_mode: ignore
    metric_statements:
      - copy_metric(name="otelcol_processor_accepted_log_records_total") where metric.name == "otelcol_processor_memory_limiter_accepted_log_records_total"
      - copy_metric(name="otelcol_processor_accepted_metric_points_total") where metric.name == "otelcol_processor_memory_limiter_accepted_metric_points_total"
      - copy_metric(name="otelcol_processor_accepted_spans_total") where metric.name == "otelcol_processor_memory_limiter_accepted_spans_total"
      - copy_metric(name="otelcol_processor_refused_log_records_total") where metric.name == "otelcol_processor_memory_limiter_refused_log_records_total"
      - copy_metric(name="otelcol_processor_refused_metric_points_total") where metric.name == "otelcol_processor_memory_limiter_refused_metric_points_total"
      - copy_metric(name="otelcol_processor_refused_spans_total") where metric.name == "otelcol_processor_memory_limiter_refused_spans_total"

service:
  pipelines:
    metrics/agent-internal:
      receivers: [prometheus/agent, count]
      processors:
        - memory_limiter
        - transform/memory_limiter_legacy_names
        - transform/truncate
        - resourcedetection
        - resourcedetection/cloud
        {{- if .HasAttributes }}
        - attributes/observe_global_attributes
        {{- end }}
        {{- if .HasResourceAttributes }}
        - resource/observe_global_resource_attributes
        {{- end }}
        {{- if .SelfMonitoring.Fleet.Enabled }}
        - resource/agent_instance
        {{- end }}
        - deltatocumulative
        - batch
      exporters: [prometheusremotewrite/observe]

    # Deprecated
    logs/agent-config:
      receivers: [nop]
      exporters: [nop]

    logs/agent-journald:
      receivers: [journald/agent]
      processors:
        - memory_limiter
        - transform/truncate
        - resourcedetection
        - resourcedetection/cloud
        {{- if .HasAttributes }}
        - attributes/observe_global_attributes
        {{- end }}
        {{- if .HasResourceAttributes }}
        - resource/observe_global_resource_attributes
        {{- end }}
        {{- if .SelfMonitoring.Fleet.Enabled }}
        - resource/agent_instance
        {{- end }}
        {{- if not .Exporters.SendingQueueBatch.Enabled }}
        - batch
        {{- end }}
      exporters: [otlphttp/observe, count]
